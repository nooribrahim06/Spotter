generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

// Prisma communicates with PostgreSQL using DATABASE_URL from prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// Roles allowed in the users table.
enum UserRole {
  USER
  COACH
  ADMIN
}

// ================ those enums all about the user profile and the user role in the system ================
enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SexForCalculation {
  MALE
  FEMALE
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
}

enum GoalType {
  LOSE_WEIGHT
  MAINTAIN_WEIGHT
  GAIN_WEIGHT
  BUILD_MUSCLE
  IMPROVE_FITNESS
}

enum GoalStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// ============= those are about body profile, nutrition profile, training profile and coaching preferences ==============
enum NutritionPlanStyle {
  EXACT_MEALS
  FLEXIBLE_MEALS
  MACRO_BASED
  SIMPLE_GUIDANCE
}

enum CookingSkill {
  NONE
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum KitchenAccess {
  NONE
  MICROWAVE_ONLY
  BASIC
  FULL
}

enum FoodBudgetLevel {
  LOW
  MODERATE
  FLEXIBLE
}

enum TrainingExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingEnvironment {
  COMMERCIAL_GYM
  HOME_GYM
  HOME_MINIMAL
  OUTDOORS
  MIXED
}

enum CoachingStyle {
  SUPPORTIVE
  BALANCED
  DIRECT
}

enum ExplanationLevel {
  CONCISE
  NORMAL
  DETAILED
}

enum MotivationStyle {
  ENCOURAGING
  ACCOUNTABILITY
  FACT_BASED
  MINIMAL
}

enum CheckinFrequency {
  DAILY
  FEW_TIMES_PER_WEEK
  WEEKLY
}

enum BodyMeasurementType {
  WAIST
  ABDOMEN
  CHEST
  HIPS
  NECK
  SHOULDERS

  LEFT_UPPER_ARM
  RIGHT_UPPER_ARM

  LEFT_FOREARM
  RIGHT_FOREARM

  LEFT_THIGH
  RIGHT_THIGH

  LEFT_CALF
  RIGHT_CALF
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealItemType {
  FOOD
  RECIPE
  QUICK
}

// ================= those are about the exercise and the workout plan ==============

enum ExerciseType {
  STRENGTH
  CARDIO
  MOBILITY
}

enum ExerciseBodyPart {
  ARMS
  BACK
  CALVES
  CHEST
  CORE
  FULL_BODY
  GLUTES
  LEGS
  SHOULDERS
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum ExerciseForce {
  PUSH
  PULL
  STATIC
}

enum ExerciseMechanic {
  COMPOUND
  ISOLATION
}

enum ExerciseEquipment {
  BARBELL
  BODY_WEIGHT
  CABLE
  DUMBBELL
  JUMP_ROPE
  KETTLEBELL
  MACHINE
  RESISTANCE_BAND
}

enum ExerciseTrackingMetric {
  SETS
  REPS
  WEIGHT
  DURATION
  DISTANCE
}

// ================= work outs enum =================
enum WorkoutStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ======================================================
// PLAN ENUMS
// ======================================================

enum PlanStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ENDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum WorkoutSlot {
  MORNING
  AFTERNOON
  EVENING
  ANYTIME
}

// A registered Spotter account. One user can have multiple active device sessions.
model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique @db.VarChar(254)
  username     String @unique @db.VarChar(30)
  passwordHash String @map("password_hash") @db.VarChar(100)

  language String   @default("en") @db.VarChar(10)
  country  String?  @db.VarChar(2)
  role     UserRole @default(USER)

  emailVerified        Boolean   @default(false) @map("email_verified")
  verifyToken          String?   @unique @map("verify_token") @db.VarChar(64)
  verifyTokenExpiresAt DateTime? @map("verify_token_expires_at") @db.Timestamptz(6)

  // Profile and onboarding fields
  // onboardingStep is 1 or 2 while forms are being saved, 3 for the review
  // screen, and null after completion because there is no next onboarding step.
  onboardingStatus             OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  onboardingStep               Int?             @default(1) @map("onboarding_step")
  fitnessOnboardingCompletedAt DateTime?        @map("fitness_onboarding_completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// IANA timezone such as "Africa/Cairo". It may be unknown at signup, but it
  /// must be collected before creating calendar-based plans or reminders.
  timezone String? @db.VarChar(64)

  // Reverse side of AuthSession.user. This field does not create a database column.
  authSessions        AuthSession[]
  goals               Goal[]
  userProfile         UserProfile?
  bodyProfile         BodyProfile?
  coachingPreferences CoachingPreferences?
  createdFoods        Food[]               @relation("UserCreatedFoods")
  createdRecipes      Recipe[]             @relation("UserCreatedRecipes")
  meals               Meal[]
  workouts            Workout[]
  plans               Plan[]

  @@map("users")
}

// One authenticated login/device. Revoking it invalidates its complete token family.
model AuthSession {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  familyId String @unique @default(uuid()) @map("family_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  // Optional device metadata. Store only bounded, non-sensitive values.
  userAgent String? @map("user_agent") @db.VarChar(512)
  ipHash    String? @map("ip_hash") @db.VarChar(64)

  // Deleting a user removes their sessions; deleting a session removes its tokens.
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

// A hashed opaque refresh token. Raw refresh tokens must never be stored.
model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid

  // SHA-256 encoded as hexadecimal is exactly 64 characters.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  // After rotation, the old token points to the new token that replaced it.
  replacedByTokenId String? @unique @map("replaced_by_token_id") @db.Uuid

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Self-relation representing: old token -> replacement token.
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

/// Public/display identity. This model may eventually be visible to friends;
/// private fitness, nutrition, and health data must never be added here.
model UserProfile {
  userId String @id @map("user_id") @db.Uuid

  /// A UserProfile is created only after onboarding supplies both names, so the
  /// fields are required inside this otherwise optional one-to-one profile.
  firstName   String  @map("first_name") @db.VarChar(40)
  lastName    String  @map("last_name") @db.VarChar(40)
  displayName String? @map("display_name") @db.VarChar(50)
  bio         String? @db.VarChar(500)

  /// Object-storage key only. The API creates a temporary/public URL when it
  /// returns the profile; image bytes and expiring URLs are never persisted.
  profilePhotoKey String? @map("profile_photo_key") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Private, stable facts used for calorie calculations and plan generation.
/// Current measurements do not belong here; they live in ProgressEntry.
model BodyProfile {
  userId String @id @map("user_id") @db.Uuid

  /// Stored as a PostgreSQL date so age is calculated accurately without time
  /// zone shifts. Age itself must never be stored because it becomes stale.
  birthDate DateTime @map("birth_date") @db.Date

  /// Audit timestamp proving the adult confirmation was accepted. It should not
  /// be rewritten during normal profile edits.
  adultConfirmedAt DateTime @map("adult_confirmed_at") @db.Timestamptz(6)

  /// Physiological input used only by formulas that require it. It is separate
  /// from any future social gender field.
  sexForCalculation SexForCalculation @map("sex_for_calculation")

  /// Values are stored canonically in metric units; preferredUnitSystem controls
  /// only how the API/UI accepts and displays them.
  preferredUnitSystem UnitSystem @map("preferred_unit_system")

  heightCm Decimal @map("height_cm") @db.Decimal(5, 2)

  /// Immutable onboarding baseline. Current weight is read from the newest
  /// ProgressEntry and must never overwrite this value.
  startingWeightKg Decimal @map("starting_weight_kg") @db.Decimal(6, 2)

  /// Used for initial calorie expenditure estimates. It stays nullable until
  /// the activity step is completed.
  activityLevel ActivityLevel? @map("activity_level")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthProfile    HealthProfile?
  nutritionProfile NutritionProfile?
  trainingProfile  TrainingProfile?
  progressEntries  ProgressEntry[]

  @@map("body_profiles")
}

model Goal {
  // goalType represents the user's current onboarding goal. later goals are
  // gonna use new rows instead of overwriting this history.
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  goalType       GoalType  @map("goal_type")
  targetWeightKg Decimal?  @map("target_weight_kg") @db.Decimal(6, 2)
  targetDate     DateTime? @map("target_date") @db.Date

  status           GoalStatus @default(DRAFT)
  // Nullable so normal future goals can coexist. Only one goal per user can
  // carry `true`, which makes onboarding saves safe to repeat.
  isOnboardingGoal Boolean?   @map("is_onboarding_goal")
  startedAt        DateTime?  @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?  @map("completed_at") @db.Timestamptz(6)
  cancelledAt      DateTime?  @map("cancelled_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressEntries ProgressEntry[]
  plans           Plan[]

  @@unique([userId, isOnboardingGoal])
  @@unique([userId], map: "one_active_goal_per_user", where: raw("status = 'ACTIVE'"))
  @@index([userId])
  @@index([userId, status])
  @@map("goals")
}

/// One private body snapshot at a specific time. BodyProfile owns the history,
/// so deleting the body profile also deletes its measurements.
model ProgressEntry {
  id String @id @default(uuid()) @db.Uuid

  bodyProfileId String  @map("body_profile_id") @db.Uuid
  goalId        String? @map("goal_id") @db.Uuid

  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  /// Main source of truth for current weight. The latest entry is the value used
  /// by the profile response, calculations, and the AI coach.
  weightKg Decimal @map("weight_kg") @db.Decimal(6, 2)

  /// Optional body-composition estimate. Useful for observing a trend, but the
  /// AI must not treat a consumer-device estimate as a medical measurement.
  bodyFatPercentage Decimal? @map("body_fat_percentage") @db.Decimal(5, 2)

  /// Optional lean-mass estimate from a consistent scale or body scan. It helps
  /// distinguish weight loss from possible muscle loss, but trend consistency
  /// matters more than a single reading.
  skeletalMuscleMassKg Decimal? @map("skeletal_muscle_mass_kg") @db.Decimal(6, 2)

  /// Optional resting pulse. Long-term changes can provide recovery and general
  /// cardiovascular context; it is not a diagnosis or a substitute for a doctor.
  restingHeartRateBpm Int? @map("resting_heart_rate_bpm") @db.SmallInt

  notes String? @db.VarChar(1000)

  // PostgreSQL permits multiple NULL values while allowing one TRUE initial entry per goal.
  isInitialForGoal Boolean? @map("is_initial_for_goal")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bodyProfile BodyProfile @relation(fields: [bodyProfileId], references: [userId], onDelete: Cascade)
  goal        Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)

  measurements ProgressMeasurement[]

  @@unique([goalId, isInitialForGoal])
  @@index([bodyProfileId, recordedAt])
  @@index([goalId])
  @@map("progress_entries")
}

/// A repeatable circumference measurement attached to one progress check-in.
/// All values are stored canonically in centimeters even when the UI shows inches.
model ProgressMeasurement {
  id              String @id @default(uuid()) @db.Uuid
  progressEntryId String @map("progress_entry_id") @db.Uuid

  measurementType BodyMeasurementType @map("measurement_type")
  valueCm         Decimal             @map("value_cm") @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  progressEntry ProgressEntry @relation(fields: [progressEntryId], references: [id], onDelete: Cascade)

  @@unique([progressEntryId, measurementType])
  @@index([progressEntryId])
  @@map("progress_measurements")
}

/// Private health and safety constraints for plan generation. A missing JSON
/// value means "not answered"; an empty array means "answered: none".
model HealthProfile {
  // bodyProfileId is both the PK and FK.
  // This guarantees one HealthProfile per BodyProfile.
  bodyProfileId String @id @map("body_profile_id") @db.Uuid

  // Flexible health information supplied by the user.
  //
  // Example:
  // [
  //   {
  //     "code": "DIABETES",
  //     "notes": "Type 2",
  //     "active": true
  //   }
  // ]
  healthConditions Json? @map("health_conditions") @db.JsonB

  // Physical restrictions relevant to exercise selection.
  //
  // Example:
  // [
  //   {
  //     "bodyRegion": "RIGHT_KNEE",
  //     "trigger": "DEEP_SQUAT",
  //     "notes": "Pain below parallel"
  //   }
  // ]
  movementLimitations Json? @map("movement_limitations") @db.JsonB

  // Special situations that may require a different planning pathway.
  //
  // Example:
  // [
  //   {
  //     "code": "POST_SURGERY",
  //     "notes": "Doctor restricted heavy lifting"
  //   }
  // ]
  specialPlanningStates Json? @map("special_planning_states") @db.JsonB

  // If true, automatic plan generation should stop or become restricted
  // until the user receives appropriate professional clearance.
  requiresProfessionalClearance Boolean @default(false) @map("requires_professional_clearance")

  // General user-provided safety information that does not fit elsewhere.
  safetyNotes String? @map("safety_notes") @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bodyProfile BodyProfile @relation(fields: [bodyProfileId], references: [userId], onDelete: Cascade)

  @@map("health_profiles")
}

/// Private nutrition constraints and preferences. Safety information such as
/// allergies remains distinct from soft preferences such as liked foods.
model NutritionProfile {
  bodyProfileId String @id @map("body_profile_id") @db.Uuid

  /// Array of validated codes such as VEGAN, VEGETARIAN, or HALAL.
  dietaryPreferenceCodes Json? @map("dietary_preference_codes") @db.JsonB

  /// Structured arrays. Allergy objects may include code, severity, and notes;
  /// preference objects may include food name/code and liked/disliked/avoided.
  foodAllergies    Json? @map("food_allergies") @db.JsonB
  foodIntolerances Json? @map("food_intolerances") @db.JsonB
  foodPreferences  Json? @map("food_preferences") @db.JsonB

  /// Meal counts and practical constraints make the generated plan realistic,
  /// rather than optimizing nutrition while ignoring the user's daily routine.
  mealsPerDay  Int? @map("meals_per_day") @db.SmallInt
  snacksPerDay Int? @map("snacks_per_day") @db.SmallInt

  planStyle          NutritionPlanStyle? @map("plan_style")
  cookingSkill       CookingSkill?       @map("cooking_skill")
  maxMealPrepMinutes Int?                @map("max_meal_prep_minutes") @db.SmallInt
  kitchenAccess      KitchenAccess?      @map("kitchen_access")
  foodBudgetLevel    FoodBudgetLevel?    @map("food_budget_level")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bodyProfile BodyProfile @relation(fields: [bodyProfileId], references: [userId], onDelete: Cascade)

  @@map("nutrition_profiles")
}

/// Private training baseline, availability, equipment, and recovery baseline.
/// Daily sleep/stress observations will later belong to DailyLog; these values
/// describe the user's typical starting point for the first plan.
model TrainingProfile {
  bodyProfileId String @id @map("body_profile_id") @db.Uuid

  overallExperienceLevel  TrainingExperienceLevel? @map("overall_experience_level")
  resistanceTrainingLevel TrainingExperienceLevel? @map("resistance_training_level")
  cardioTrainingLevel     TrainingExperienceLevel? @map("cardio_training_level")

  currentlyTrainingConsistently Boolean? @map("currently_training_consistently")
  trainingDaysPerWeek           Int?     @map("training_days_per_week") @db.SmallInt
  /// Structured days may include day number, availability, preferred status,
  /// and optional time limits. The service must validate the JSON shape.
  availableDays                 Json?    @map("available_days") @db.JsonB

  preferredSessionMinutes Int?                 @map("preferred_session_minutes") @db.SmallInt
  trainingEnvironment     TrainingEnvironment? @map("training_environment")

  /// Structured equipment may include code, quantity, and maximum weight.
  availableEquipment Json? @map("available_equipment") @db.JsonB

  /// Array of validated style codes used to choose enjoyable workouts.
  preferredTrainingStyles Json?   @map("preferred_training_styles") @db.JsonB
  preferredCardioType     String? @map("preferred_cardio_type") @db.VarChar(100)

  averageSleepMinutes Int? @map("average_sleep_minutes") @db.SmallInt
  sleepQuality        Int? @map("sleep_quality") @db.SmallInt
  typicalStressLevel  Int? @map("typical_stress_level") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bodyProfile BodyProfile @relation(fields: [bodyProfileId], references: [userId], onDelete: Cascade)

  @@map("training_profiles")
}

/// Controls how the AI coach communicates. Communication defaults are safe,
/// while proactive behavior and reminders require explicit user consent.
model CoachingPreferences {
  userId String @id @map("user_id") @db.Uuid

  coachingStyle    CoachingStyle     @default(BALANCED) @map("coaching_style")
  explanationLevel ExplanationLevel  @default(NORMAL) @map("explanation_level")
  motivationStyle  MotivationStyle?  @map("motivation_style")
  checkinFrequency CheckinFrequency? @map("checkin_frequency")

  /// Opt-in fields: never enable unsolicited coaching or reminders by default.
  proactiveCoaching  Boolean @default(false) @map("proactive_coaching")
  workoutReminders   Boolean @default(false) @map("workout_reminders")
  nutritionReminders Boolean @default(false) @map("nutrition_reminders")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coaching_preferences")
}

/// A selectable food in Spotter's nutrition catalog.
/// Global catalog foods have no creator. User-created foods remain private to
/// their creator. Nutrition is normalized to 100 grams for consistent logging.
model Food {
  id String @id @default(uuid()) @db.Uuid

  nameEn   String  @map("name_en") @db.VarChar(200)
  nameAr   String? @map("name_ar") @db.VarChar(200)
  aliases  Json?   @db.JsonB
  category String? @db.VarChar(100)

  caloriesPer100g          Decimal @map("calories_per_100g") @db.Decimal(8, 2)
  proteinGramsPer100g      Decimal @map("protein_grams_per_100g") @db.Decimal(8, 2)
  carbohydrateGramsPer100g Decimal @map("carbohydrate_grams_per_100g") @db.Decimal(8, 2)
  fatGramsPer100g          Decimal @map("fat_grams_per_100g") @db.Decimal(8, 2)

  /// NULL identifies a global Spotter catalog food.
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  source           String? @db.VarChar(50)
  externalSourceId String? @map("external_source_id") @db.VarChar(100)
  sourceVersion    String? @map("source_version") @db.VarChar(50)

  /// Catalog entries are archived rather than deleted so historical references
  /// and imported identifiers remain stable.
  isActive   Boolean   @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByUser User? @relation("UserCreatedFoods", fields: [createdByUserId], references: [id], onDelete: Cascade)

  recipeIngredients RecipeIngredient[]
  mealItems         MealItem[]

  @@unique([source, externalSourceId])
  @@index([nameEn])
  @@index([category])
  @@index([createdByUserId])
  @@index([isActive])
  @@map("foods")
}

/// A reusable prepared dish made from Food records. Nutrition per serving is
/// calculated and cached by the service whenever the recipe changes.
model Recipe {
  id String @id @default(uuid()) @db.Uuid

  nameEn  String  @map("name_en") @db.VarChar(200)
  nameAr  String? @map("name_ar") @db.VarChar(200)
  aliases Json?   @db.JsonB

  /// NULL identifies a global Spotter recipe.
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  servings        Decimal @db.Decimal(6, 2)
  totalYieldGrams Decimal @map("total_yield_grams") @db.Decimal(10, 2)

  caloriesPerServing          Decimal @map("calories_per_serving") @db.Decimal(10, 2)
  proteinGramsPerServing      Decimal @map("protein_grams_per_serving") @db.Decimal(10, 2)
  carbohydrateGramsPerServing Decimal @map("carbohydrate_grams_per_serving") @db.Decimal(10, 2)
  fatGramsPerServing          Decimal @map("fat_grams_per_serving") @db.Decimal(10, 2)

  countryCode String? @map("country_code") @db.VarChar(2)
  cuisine     String? @db.VarChar(100)

  instructions String? @db.Text

  source           String? @db.VarChar(50)
  externalSourceId String? @map("external_source_id") @db.VarChar(100)
  sourceVersion    String? @map("source_version") @db.VarChar(50)

  isActive   Boolean   @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByUser User? @relation("UserCreatedRecipes", fields: [createdByUserId], references: [id], onDelete: Cascade)

  ingredients RecipeIngredient[]
  mealItems   MealItem[]

  @@unique([source, externalSourceId])
  @@index([nameEn])
  @@index([createdByUserId])
  @@index([countryCode])
  @@index([cuisine])
  @@index([isActive])
  @@map("recipes")
}

/// One food and its gram quantity inside a recipe.
model RecipeIngredient {
  id String @id @default(uuid()) @db.Uuid

  recipeId String @map("recipe_id") @db.Uuid
  foodId   String @map("food_id") @db.Uuid

  quantityGrams Decimal @map("quantity_grams") @db.Decimal(10, 2)
  orderIndex    Int     @map("order_index")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@unique([recipeId, orderIndex])
  @@index([recipeId])
  @@index([foodId])
  @@map("recipe_ingredients")
}

/// A breakfast, lunch, dinner, or snack actually logged by a user.
model Meal {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  mealType   MealType @map("meal_type")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  notes      String?  @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              MealItem[]
  sourcePlanDayId    String?    @map("source_plan_day_id") @db.Uuid
  sourceMealOptionId String?    @map("source_meal_option_id") @db.Uuid
  scheduledDate      DateTime?  @map("scheduled_date") @db.Date

  sourcePlanDay PlanDay? @relation(fields: [sourcePlanDayId], references: [id], onDelete: SetNull)

  @@index([sourcePlanDayId])
  @@index([scheduledDate])
  @@index([userId, occurredAt])
  @@map("meals")
}

/// One food or recipe consumed inside a Meal. Nutrition and the display name
/// are snapshots so edits to catalog data never rewrite the user's history.
model MealItem {
  id String @id @default(uuid()) @db.Uuid

  mealId String @map("meal_id") @db.Uuid

  itemType MealItemType @map("item_type")
  foodId   String?      @map("food_id") @db.Uuid
  recipeId String?      @map("recipe_id") @db.Uuid

  itemName   String @map("item_name") @db.VarChar(200)
  orderIndex Int    @map("order_index")

  /// FOOD items use quantityGrams; RECIPE items use servings.
  quantityGrams Decimal? @map("quantity_grams") @db.Decimal(10, 2)
  servings      Decimal? @db.Decimal(8, 2)

  calories          Decimal  @db.Decimal(10, 2)
  proteinGrams      Decimal? @map("protein_grams") @db.Decimal(10, 2)
  carbohydrateGrams Decimal? @map("carbohydrate_grams") @db.Decimal(10, 2)
  fatGrams          Decimal? @map("fat_grams") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  meal   Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food   Food?   @relation(fields: [foodId], references: [id], onDelete: Restrict)
  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@unique([mealId, orderIndex])
  @@index([mealId])
  @@index([foodId])
  @@index([recipeId])
  @@map("meal_items")
}

model Exercise {
  id String @id @default(uuid()) @db.Uuid

  slug String @unique @db.VarChar(120)
  name String @db.VarChar(160)

  exerciseType ExerciseType       @map("exercise_type")
  bodyPart     ExerciseBodyPart   @map("body_part")
  difficulty   ExerciseDifficulty

  force    ExerciseForce?
  mechanic ExerciseMechanic?

  equipment ExerciseEquipment

  primaryMuscles   String[] @default([]) @map("primary_muscles")
  secondaryMuscles String[] @default([]) @map("secondary_muscles")
  instructions     String[] @default([])

  // Cloudinary public ID for the GIF, without a file extension or full URL.
  // The API derives both the animated GIF and its static preview from this ID.
  gifPublicId String? @map("gif_public_id") @db.VarChar(255)

  isActive Boolean @default(true) @map("is_active")

  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  trackingMetrics  ExerciseTrackingMetric[] @default([]) @map("tracking_metric")
  //A list of all workout exercises that use this exercise.
  workoutExercises WorkoutExercise[]

  @@index([bodyPart])
  @@index([equipment])
  @@index([difficulty])
  @@index([exerciseType])
  @@index([isActive])
  @@map("exercises")
}

model Workout {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  name   String?       @db.VarChar(160)
  status WorkoutStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  durationMinutes Int? @map("duration_minutes")

  estimatedCaloriesBurned Int? @map("estimated_calories_burned")

  notes String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  exercises           WorkoutExercise[]
  sourcePlanWorkoutId String?           @map("source_plan_workout_id") @db.Uuid
  scheduledDate       DateTime?         @map("scheduled_date") @db.Date

  sourcePlanWorkout PlanWorkout? @relation(fields: [sourcePlanWorkoutId], references: [id], onDelete: SetNull)

  @@index([sourcePlanWorkoutId])
  @@index([scheduledDate])
  @@unique(  [sourcePlanWorkoutId, scheduledDate],  map: "one_active_workout_per_scheduled_occurrence",  where: raw("status IN ('IN_PROGRESS', 'COMPLETED')"))
  @@index([userId, startedAt])
  @@index([userId, status])
  @@map("workouts")
}

model WorkoutExercise {
  id String @id @default(uuid()) @db.Uuid

  workoutId  String @map("workout_id") @db.Uuid
  exerciseId String @map("exercise_id") @db.Uuid

  exerciseOrder Int @map("exercise_order") @db.SmallInt

  // Strength summary: 3 sets × 10 reps × 40 kg.
  setsCount  Int?     @map("sets_count") @db.SmallInt
  repsPerSet Int?     @map("reps_per_set") @db.SmallInt
  weightKg   Decimal? @map("weight_kg") @db.Decimal(6, 2)

  // Cardio and mobility summary.
  durationSeconds Int?     @map("duration_seconds")
  distanceMeters  Decimal? @map("distance_meters") @db.Decimal(10, 2)

  completed Boolean @default(false)
  notes     String? @db.VarChar(1000)

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutId, exerciseOrder])
  @@unique([workoutId, exerciseId])
  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

// ======================================================
// PLAN TEMPLATE
// ======================================================

/// Internal reusable blueprint used as a reference during AI generation.
/// This is NOT a user's actual personalized plan.
model PlanTemplate {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(255)
  description String? @db.Text

  goalType        GoalType                @map("goal_type")
  experienceLevel TrainingExperienceLevel @map("experience_level")

  durationWeeks Int? @map("duration_weeks") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  days  PlanTemplateDay[]
  plans Plan[]

  @@index([goalType, experienceLevel])
  @@map("plan_templates")
}

// ======================================================
// PLAN TEMPLATE DAY
// ======================================================

/// Generic training day inside a reusable template.
///
/// dayNumber is a training-day order, NOT a weekday.
///
/// Example:
/// Day 1 — Upper Body
/// Day 2 — Lower Body
model PlanTemplateDay {
  id String @id @default(uuid()) @db.Uuid

  planTemplateId String @map("plan_template_id") @db.Uuid

  dayNumber Int    @map("day_number") @db.SmallInt
  name      String @db.VarChar(100)

  /// High-level workout reference for the AI.
  ///
  /// Example:
  /// {
  ///   "focus": "UPPER_BODY",
  ///   "targetDurationMinutes": 60,
  ///   "movementPatterns": [
  ///     "HORIZONTAL_PUSH",
  ///     "HORIZONTAL_PULL",
  ///     "VERTICAL_PUSH",
  ///     "VERTICAL_PULL"
  ///   ]
  /// }
  workoutBlueprint Json? @map("workout_blueprint") @db.JsonB

  /// Optional nutrition structure reference.
  ///
  /// Example:
  /// {
  ///   "mealPattern": "HIGH_PROTEIN",
  ///   "proteinDistribution": "EVEN"
  /// }
  nutritionBlueprint Json? @map("nutrition_blueprint") @db.JsonB

  notes String? @db.Text

  planTemplate PlanTemplate @relation(fields: [planTemplateId], references: [id], onDelete: Cascade)

  @@unique([planTemplateId, dayNumber])
  @@index([planTemplateId])
  @@map("plan_template_days")
}

// ======================================================
// PERSONALIZED USER PLAN
// ======================================================

/// A personalized plan generated for one specific user.
///
/// The source template is only a reference used during generation.
/// The saved plan is independent from the template afterward.
// ======================================================
// PLAN
// ======================================================

model Plan {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  goalId String @map("goal_id") @db.Uuid

  sourceTemplateId String? @map("source_template_id") @db.Uuid

  status PlanStatus @default(DRAFT)

  nutritionPlanStyle NutritionPlanStyle @map("nutrition_plan_style")

  title       String? @db.VarChar(160)
  explanation String? @db.Text

  calorieTarget           Int? @map("calorie_target")
  proteinTargetGrams      Int? @map("protein_target_grams")
  carbohydrateTargetGrams Int? @map("carbohydrate_target_grams")
  fatTargetGrams          Int? @map("fat_target_grams")

  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  // NEW
  timezone String @db.VarChar(64)

  activatedAt DateTime? @map("activated_at") @db.Timestamptz(6)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  sourceTemplate PlanTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)

  days PlanDay[]

  @@unique([userId], map: "one_active_plan_per_user", where: raw("status = 'ACTIVE'"))
  @@index([userId])
  @@index([goalId])
  @@index([sourceTemplateId])
  @@index([userId, status])
  @@map("plans")
}

// ======================================================
// PERSONALIZED PLAN DAY
// ======================================================

/// One weekday inside the user's personalized plan.
model PlanDay {
  id String @id @default(uuid()) @db.Uuid

  planId String @map("plan_id") @db.Uuid

  dayOfWeek DayOfWeek @map("day_of_week")

  /// EXACT_MEALS:
  /// normally one generated option.
  ///
  /// FLEXIBLE_MEALS:
  /// multiple alternatives.
  ///
  /// MACRO_BASED / SIMPLE_GUIDANCE:
  /// these may remain null.
  ///
  /// Example:
  /// [
  ///   {
  ///     "recipeId": "uuid",
  ///     "servings": 1.5,
  ///     "note": "Primary option"
  ///   }
  /// ]
  breakfastOptions Json? @map("breakfast_options") @db.JsonB
  lunchOptions     Json? @map("lunch_options") @db.JsonB
  dinnerOptions    Json? @map("dinner_options") @db.JsonB
  snackOptions     Json? @map("snack_options") @db.JsonB

  nutritionGuidance String? @map("nutrition_guidance") @db.Text

  notes String? @db.Text

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  workouts PlanWorkout[]
  meals    Meal[]

  @@unique([planId, dayOfWeek])
  @@index([planId])
  @@map("plan_days")
}

// ======================================================
// PERSONALIZED PLANNED WORKOUT
// ======================================================

/// A workout prescribed inside a personalized PlanDay.
///
/// This represents what the user SHOULD do.
/// It is separate from the existing Workout model,
/// which represents what the user ACTUALLY did.
model PlanWorkout {
  id String @id @default(uuid()) @db.Uuid

  planDayId String @map("plan_day_id") @db.Uuid

  slot WorkoutSlot @default(ANYTIME)

  // NEW
  orderIndex Int @map("order_index") @db.SmallInt

  name String @db.VarChar(160)

  estimatedDurationMinutes Int? @map("estimated_duration_minutes") @db.SmallInt

  exercises Json @db.JsonB

  notes String? @db.Text

  planDay PlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)

  // NEW reverse relation
  workouts Workout[]

  @@unique([planDayId, orderIndex])
  @@index([planDayId])
  @@map("plan_workouts")
}
 